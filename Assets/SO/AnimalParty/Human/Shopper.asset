  name: "\u5E97\u957F"
  sprite: {fileID: 21300000, guid: 76e7ea42724a0774caf3e4907f134bf6, type: 3}
  color: {r: 0.7169812, g: 0.4091786, b: 0.19209681, a: 1}
  background: "\u706B\u707E\u4F7F\u4F60\u51E0\u4E4E\u5931\u53BB\u4E86\u4E00\u5207\uFF0C\u4F60\u4E00\u76F4\u5728\u67E5\u627E\u5F53\u5E74\u7684\u9003\u4EA1\u7684\u706B\u707E\u72AF\uFF0C\u4F60\u4E0D\u77E5\u9053\u8FD9\u5C01\u5B64\u5C9B\u6E38\u620F\u9080\u8BF7\u51FD\u7684\u76EE\u7684\uFF0C\u4F46\u54EA\u6015\u662F\u4E00\u4E1D\u7EBF\u7D22\u4E5F\u503C\u5F97\u5C1D\u8BD5\u3002"
  perspetive: "\u4F60\u662F<mark=#FFB6C165><color=#FFFFFFFF><b>\u82B1\u519C</mark></color></b>\u7684\u5144\u957F\uFF0C\u706B\u707E\u4F7F\u4F60\u4EEC\u4E24\u4E2A\u76F8\u4F9D\u4E3A\u547D\uFF0C\u5C3D\u7BA1\u5979\u4F3C\u4E4E\u5F88\u8BA8\u538C\u4F60\uFF0C\u4F46\u662F\u4F60\u4ECD\u7136\u4F1A\u4FDD\u62A4\u5979\u3002\n<u>\u5F53<mark=#FFB6C165><color=#FFFFFFFF><b>\u82B1\u519C</mark></color></b>\u88AB\u5176\u4ED6\u73A9\u5BB6\u6DD8\u6C70\u540E\uFF0C\u4F60\u9700\u8981\u4F18\u5148\u6307\u8BA4\u8BE5\u73A9\u5BB6\uFF0C\u5F53\u4F60\u53EA\u8BA4\u8BE5\u73A9\u5BB6\u6210\u529F\u65F6\uFF0C\u989D\u5916\u83B7\u5F97\u4E00\u5206\u3002\n</u>\u4F60\u5341\u5206\u618E\u6068\u8FD9\u573A\u706B\u707E\u7684\u5143\u51F6\uFF0C\u81EA\u4ECE\u4F60\u5F97<mark=#FF450065><color=#FFFFFFFF><b>\u201C\u7EB5\u706B\u8005\u201D</mark></color></b>\u9003\u4EA1\u4E86\u4E4B\u540E\uFF0C\u4F60\u65E0\u65F6\u65E0\u523B\u4E5F\u60F3\u628A\u4ED6\u7ED9\u6293\u4F4F\u3002\n<u>\u5F53\u573A\u4E0A\u5B58\u5728<mark=#FF450065><color=#FFFFFFFF><b>\u201C\u7EB5\u706B\u8005\u201D</mark></color></b>\u65F6\uFF0C\u4F60\u9700\u8981\u4F18\u5148\u6307\u8BA4\u8BE5\u73A9\u5BB6\u3002\u5F53\u5176\u6B7B\u4EA1\u65F6\u83B7\u5F97\u4E00\u5206\uFF0C\u82E5\u662F\u56E0\u4E3A\u88AB\u4F60\u6307\u8BA4\u4E86\u88AB\u6DD8\u6C70\u989D\u5916\u83B7\u5F97\u4E00\u5206\u3002</u>"
  otherRelation: "\u51FA\u4E8E\u67D0\u79CD\u8BEF\u4F1A\uFF0C<mark=#FFB6C165><color=#FFFFFFFF><b>\u82B1\u519C</mark></color></b>\u618E\u6068\u4E8E\u4F60\u3002\n<mark=#228B2265><color=#FFFFFFFF><b>\u730E\u4EBA</mark></color></b>\u4E5F\u5F88\u8BA8\u538C\u4F60\u3002"
  skill: "\u5F53\u4F60\u6210\u4E3A\u4EE3\u7406\u4E3B\u6301\u65F6\uFF0C\u4F60\u53EF\u4EE5\u989D\u5916\u53D1\u8D77\u4E00\u6B21\u4EA4\u6613\u3002"
  alphaInBG: 65
  colorTxt: 8B4513
