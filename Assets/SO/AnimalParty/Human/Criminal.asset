  name: "\u201C\u7EB5\u706B\u8005\u201D"
  sprite: {fileID: 21300000, guid: 382b8ae70d1111f449ab60989cfe5541, type: 3}
  color: {r: 0.5660378, g: 0.2620081, b: 0.1463154, a: 1}
  background: "\u4F60\u77E5\u9053\u8FD9\u662F\u4E00\u573A\u65E0\u5984\u4E4B\u707E\uFF0C\u6240\u4EE5\u5728\u6536\u5230\u6709\u7F6A\u5224\u51B3\u7684\u90A3\u4E00\u523B\uFF0C\u4F60\u51B3\u5FC3\u5F00\u59CB\u9003\u4EA1\u3002\u4F60\u65E0\u8BBA\u5982\u4F55\u90FD\u60F3\u6D17\u6E05\u7F6A\u540D\uFF0C\u8FD9\u662F\u4F60\u6765\u5230\u8FD9\u5EA7\u5C9B\u5C7F\u7684\u552F\u4E00\u7406\u7531\u3002"
  perspetive: "<mark=#228B2265><color=#FFFFFFFF><b>\u730E\u4EBA</mark></color></b>\u662F\u4F60\u7684\u54E5\u54E5\uFF0C\u4F46\u4ED6\u5728\u6700\u540E\u5173\u5934\u7ADF\u7136\u4E5F\u4E0D\u76F8\u4FE1\u4F60\u3002\u4F60\u53EF\u4EE5\u6307\u8BA4<mark=#228B2265><color=#FFFFFFFF><b>\u730E\u4EBA</mark></color></b>\uFF0C\u4F46\u5982\u679C\u5176\u4ED6\u4EBA\u6740\u6B7B\u4E86\u4ED6\uFF0C\u4F60\u9700\u8981\u590D\u4EC7\u3002\n<u>\u5F53<mark=#228B2265><color=#FFFFFFFF><b>\u730E\u4EBA</mark></color></b>\u88AB\u5176\u4ED6\u73A9\u5BB6\u6DD8\u6C70\u540E\uFF0C\u4F60\u9700\u8981\u4F18\u5148\u6307\u8BA4\u8BE5\u73A9\u5BB6\uFF0C\u5F53\u4F60\u6307\u8BA4\u8BE5\u73A9\u5BB6\u6210\u529F\u65F6\uFF0C\u989D\u5916\u83B7\u5F97\u4E00\u5206\u3002\n</u>\u4F60\u77E5\u9053\u81EA\u5DF1\u4E0D\u53EF\u80FD\u5728\u5C71\u4E0A\u5438\u70DF\uFF0C\u56E0\u6B64<mark=#00008075><color=#FFFFFFFF><b>\u8B66\u5BDF</mark></color></b>\u53E3\u4E2D\u5728\u8D77\u706B\u70B9\u627E\u5230\u7684\u70DF\u5934\u4E00\u5B9A\u662F\u4F2A\u8BC1\uFF0C\u6240\u4EE5\u4F60\u4EC7\u6068<mark=#00008075><color=#FFFFFFFF><b>\u8B66\u5BDF</mark></color></b>\u3002\n<u>\u5F53\u573A\u4E0A\u5B58\u5728<mark=#00008075><color=#FFFFFFFF><b>\u8B66\u5BDF</mark></color></b>\u65F6\uFF0C\u4F60\u9700\u8981\u4F18\u5148\u6307\u8BA4\u8BE5\u73A9\u5BB6\u3002\u5F53\u5176\u6B7B\u4EA1\u65F6\u83B7\u5F97\u4E00\u5206\uFF0C\u82E5\u662F\u56E0\u4E3A\u88AB\u4F60\u6307\u8BA4\u4E86\u800C\u88AB\u6DD8\u6C70\uFF0C\u989D\u5916\u83B7\u5F97\u4E00\u5206\u3002</u>"
  otherRelation: "<mark=#8B451365><color=#FFFFFFFF><b>\u5E97\u957F</mark></color></b>\u8BA4\u4E3A\u4F60\u662F\u771F\u51F6\u800C\u618E\u6068\u4F60\u3002\n<mark=#84891D75><color=#FFFFFFFF><b>\u5F8B\u5E08</mark></color></b>\u4F1A\u5E2E\u52A9\u4F60\u3002"
  skill: "\u5F53\u4F60\u6210\u4E3A\u4EE3\u7406\u4E3B\u6301\u65F6\uFF0C\u5982\u679C\u6709\u73A9\u5BB6\u5728\u56DE\u5408\u5185\u88AB\u6DD8\u6C70\uFF0C\u5219\u4F60\u53EF\u4EE5\u83B7\u5F97\u8BE5\u73A9\u5BB6\u7684\u6240\u6709\u624B\u724C\uFF0C\u7136\u540E\u4F60\u9700\u8981\u80CC\u9762\u5411\u4E0A\u5F03\u7F6E\u76F8\u5E94\u6570\u91CF\u7684\u624B\u724C\u3002"
  alphaInBG: 65
