  name: "\u82B1\u519C"
  sprite: {fileID: 21300000, guid: cddd2e4caec5f444eb3f9520f5c66e12, type: 3}
  color: {r: 0.7169812, g: 0.4829477, b: 0.51951545, a: 1}
  background: "\u706B\u707E\u53D1\u751F\u65F6\uFF0C\u4F60\u5F53\u65F6\u5E74\u7EAA\u5C1A\u5C0F\uFF0C\u5982\u4ECA\u4F60\u5DF2\u957F\u5927\uFF0C\u4F46\u5BF9\u706B\u707E\u4E00\u6848\u53CD\u800C\u8D8A\u53D1\u803F\u803F\u4E8E\u6000\uFF0C\u56E0\u6B64\u4F60\u6BEB\u4E0D\u72B9\u8C6B\u7684\u6765\u5230\u4E86\u8FD9\u5EA7\u5B64\u5C9B\u4E0A\u3002"
  perspetive: "\u4F60\u5341\u5206\u618E\u6068<mark=#8B451365><color=#FFFFFFFF><b>\u5E97\u957F</mark></color></b>\uFF0C\u5C3D\u7BA1\u4F60\u77E5\u9053\u706B\u707E\u5E76\u4E0D\u662F\u7531\u4ED6\u5F15\u8D77\u7684\uFF0C\u4F46\u5982\u679C\u4E0D\u662F\u4ED6\u5F53\u5929\u6267\u610F\u8981\u53BB\u5C71\u4E0A\u6E38\u73A9\uFF0C\u4E5F\u4E0D\u4F1A\u53D1\u751F\u8FD9\u6837\u7684\u4E8B\u60C5\u3002\n<u>\u5F53\u573A\u4E0A\u5B58\u5728<mark=#8B451365><color=#FFFFFFFF><b>\u5E97\u957F</mark></color></b>\u65F6\uFF0C\u4F60\u9700\u8981\u4F18\u5148\u6307\u8BA4<mark=#8B451365><color=#FFFFFFFF><b>\u5E97\u957F</mark></color></b>\u3002\u5F53\u5176\u6B7B\u4EA1\u65F6\u83B7\u5F97\u4E00\u5206\uFF0C\u82E5\u662F\u56E0\u4E3A\u88AB\u4F60\u6307\u8BA4\u4E86\u88AB\u6DD8\u6C70\u989D\u5916\u83B7\u5F97\u4E00\u5206\u3002\n</u>\u4F60\u5BF9<mark=#228B2265><color=#FFFFFFFF><b>\u730E\u4EBA</mark></color></b>\u4ECE\u706B\u573A\u4E2D\u5C06\u4F60\u6551\u51FA\u8FD9\u4EF6\u4E8B\u5341\u5206\u611F\u6FC0\uFF0C\u4F60\u4E50\u610F\u5728\u5173\u952E\u65F6\u523B\u5E2E<mark=#228B2265><color=#FFFFFFFF><b>\u730E\u4EBA</mark></color></b>\u4E00\u628A\u3002\n<u>\u5F53<mark=#228B2265><color=#FFFFFFFF><b>\u730E\u4EBA</mark></color></b>\u6700\u7EC8\u751F\u8FD8\u65F6\uFF0C\u4F60\u989D\u5916\u5F97\u4E00\u5206\u3002</u>"
  otherRelation: "<mark=#8B451365><color=#FFFFFFFF><b>\u5E97\u957F</mark></color></b>\u662F\u4F60\u7684\u54E5\u54E5\uFF0C\u4ED6\u5E38\u5E38\u4F1A\u4FDD\u62A4\u4F60\u3002\n<mark=#6B8E2365><color=#FFFFFFFF><b>\u62A4\u6797\u5458</mark></color></b>\u5F88\u8BA8\u538C\u4F60\u3002"
  skill: "\u5F53\u4F60\u6210\u4E3A\u4EE3\u7406\u4E3B\u6301\u65F6\uFF0C\u4F60\u53EF\u4EE5\u9009\u62E9\u8DF3\u8FC7\u67D0\u4E00\u540D\u73A9\u5BB6\u7684\u4EA4\u6613\u9636\u6BB5\u3002"
  alphaInBG: 65
  colorTxt: FFB6C1
