  background: "\u4F60\u66FE\u65C5\u884C\u8FC7\u65E0\u6570\u4E2A\u5730\u65B9\uFF0C\u4F60\u5E76\u4E0D\u77E5\u9053\u4E3A\u4EC0\u4E48\u4F1A\u88AB\u9080\u8BF7\u3002\u4F60\u6765\u5230\u8FD9\u5EA7\u5C9B\u7684\u552F\u4E00\u7406\u7531\u662F\u4F20\u95FB\u4E2D\u7684\u4E30\u539A\u5956\u91D1\u3002"
  perspetive: "\u5F53\u4F60\u660E\u767D\u4E86\u8FD9\u573A\u6E38\u620F\u7684\u6B8B\u9177\u6027\u4E4B\u540E\uFF0C\u4F60\u53EA\u5269\u4E0B\u4E00\u4E2A\u613F\u671B\uFF1A\u5B89\u5168\u56DE\u53BB\u3002\n\u4F60\u5E76\u4E0D\u8BA4\u8BC6\u5176\u4ED6\u53C2\u52A0\u6E38\u620F\u7684\u4EBA\uFF0C\u4E5F\u4E0D\u60F3\u4E0E\u4ED6\u4EEC\u6709\u4EFB\u4F55\u74DC\u845B\u3002"
  otherRelation: "\u65E0\u5176\u5B83\u4EBA\u9645\u5173\u7CFB\u3002"
  skill: "\u5F53\u4F60\u6210\u4E3A\u4EE3\u7406\u4E3B\u6301\u65F6\uFF0C\u82E5\u56DE\u672C\u5185\u4F60\u88AB\u6307\u8BA4\u8EAB\u4EFD\u5E76\u6B63\u786E\uFF0C\u5219\u4F60\u5728\u88AB\u6DD8\u6C70\u524D\u5C06\u4F1A\u81EA\u52A8\u53D1\u8D77\u4E00\u6B21\u6447\u94C3\u5E76\u4E14\u53EA\u80FD\u6307\u8BA4\u6307\u8BA4\u4F60\u7684\u4EBA\u3002\u5982\u679C\u4F60\u6307\u8BA4\u6B63\u786E\uFF0C\u5219\u5BF9\u65B9\u5C06\u4F1A\u5728\u4F60\u4E4B\u524D\u88AB\u6DD8\u6C70\uFF0C\u5982\u679C\u6B64\u65F6\u573A\u4E0A\u53EA\u5269\u4E24\u4EBA\uFF0C\u5219\u4F60\u5C06\u6210\u4E3A\u6700\u540E\u751F\u8FD8\u8005\uFF1B\u5982\u679C\u5931\u8D25\uFF0C\u5BF9\u65B9\u4ECD\u7136\u53EA\u80FD\u83B7\u5F97\u4E00\u5F20\u724C\u3002"
