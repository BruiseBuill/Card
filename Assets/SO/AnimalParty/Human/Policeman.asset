  name: "\u8B66\u5BDF"
  sprite: {fileID: 21300000, guid: 033e65de9bef69b4099901f7428c28a3, type: 3}
  color: {r: 0.18981841, g: 0.38449422, b: 0.5849056, a: 1}
  background: "\u706B\u707E\u540E\uFF0C\u4F60\u51ED\u501F<mark=#8B451365><color=#FFFFFFFF><b>\u5E97\u957F</mark></color></b>\u5728\u8D77\u706B\u70B9\u5904\u53D1\u73B0\u7684\u70DF\u5934\uFF0C\u9501\u5B9A\u4E86<mark=#FF450065><color=#FFFFFFFF><b>\u201C\u7EB5\u706B\u8005\u201D</mark></color></b>\u3002\u867D\u7136\u6848\u4EF6\u5DF2\u7ECF\u7ED3\u675F\uFF0C\u4F46\u4F60\u4ECD\u7136\u9690\u9690\u4E0D\u5B89\uFF0C\u6216\u8BB8\u8FD9\u6B21\u5B64\u5C9B\u4E4B\u65C5\u80FD\u4F7F\u4F60\u5E73\u9759\u4E0B\u6765\u3002"
  perspetive: "\u4F60\u548C<mark=#84891D75><color=#FFFFFFFF><b>\u5F8B\u5E08</mark></color></b>\u662F\u5B66\u751F\u65F6\u671F\u5C31\u516C\u8BA4\u7684\u597D\u670B\u53CB\uFF0C\u4F46\u662F\u706B\u707E\u4E00\u6848\u6700\u7EC8\u4F7F\u5F97\u4F60\u4EEC\u4E24\u4EBA\u5F62\u540C\u964C\u8DEF\u3002\n<u>\u5F53\u573A\u4E0A\u5B58\u5728<mark=#84891D75><color=#FFFFFFFF><b>\u5F8B\u5E08</mark></color></b>\u5E76\u4E14\u5B58\u5728\u4EFB\u4F55\u7B2C\u4E09\u8005\u65F6\uFF0C\u4F60\u4E0D\u80FD\u6307\u8BA4<mark=#84891D75><color=#FFFFFFFF><b>\u5F8B\u5E08</mark></color></b>\uFF0C\u5426\u5219\u65E0\u8BBA\u6210\u529F\u4E0E\u5426\uFF0C\u4F60\u51CF\u5C11\u4E24\u5206\u3002\n</u>\u4F60\u8BA4\u4E3A<mark=#6B8E2365><color=#FFFFFFFF><b>\u62A4\u6797\u5458</mark></color></b>\u5728\u5EAD\u5BA1\u65F6\u7684\u8868\u73B0\u660E\u663E\u662F\u5728\u8BF4\u8C0E\uFF0C\u4F46\u4E5F\u6CA1\u6709\u5B9E\u8D28\u6027\u7684\u8BC1\u636E\u3002\u4F60\u5BF9\u4ED6\u975E\u5E38\u8BA8\u538C\u3002\n<u>\u5F53\u573A\u4E0A\u5B58\u5728<mark=#6B8E2365><color=#FFFFFFFF><b>\u62A4\u6797\u5458</mark></color></b>\u65F6\uFF0C\u5982\u679C\u4ED6\u5728\u4F60\u4E4B\u524D\u88AB\u6DD8\u6C70\uFF0C\u4F60\u83B7\u5F97\u4E24\u5206\u3002</u>"
  otherRelation: "\u4F60\u4E5F\u662F<mark=#84891D75><color=#FFFFFFFF><b>\u5F8B\u5E08</mark></color></b>\u7684\u201C\u597D\u670B\u53CB\u201D\u3002\n<mark=#FF450065><color=#FFFFFFFF><b>\u201C\u7EB5\u706B\u8005\u201D</mark></color></b>\u5341\u5206\u618E\u6068\u4F60\u3002"
  skill: "\u5F53\u4F60\u6210\u4E3A\u4EE3\u7406\u4E3B\u6301\u65F6\uFF0C\u5728\u4EA4\u6613\u9636\u6BB5\u5F00\u59CB\u4E4B\u524D\uFF0C\u4F60\u53EF\u4EE5\u5BA3\u5E03\u6212\u4E25\uFF0C\u672C\u56DE\u5408\u5C06\u6CA1\u6709\u4EA4\u6613\u9636\u6BB5\uFF0C\u76F4\u63A5\u8FDB\u5165\u751F\u5B58\u3002\u5168\u5C40\u4EC5\u9650\u4E00\u6B21\u3002"
  alphaInBG: 75
