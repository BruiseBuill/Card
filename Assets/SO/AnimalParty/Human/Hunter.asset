  name: "\u730E\u4EBA"
  sprite: {fileID: 21300000, guid: a20e2edb30d0cae4b94d1b4bae25264f, type: 3}
  color: {r: 0.103595555, g: 0.5660378, b: 0.19772097, a: 1}
  background: "\u4F60\u5728\u5C71\u706B\u4E2D\u6551\u4E0B\u4E86<mark=#8B451365><color=#FFFFFFFF><b>\u5E97\u957F</mark></color></b>\u548C<mark=#FFB6C165><color=#FFFFFFFF><b>\u82B1\u519C</mark></color></b>\uFF0C\u4F46\u672A\u66FE\u60F3\u5230\uFF0C\u4F60\u7684\u5F1F\u5F1F\u88AB\u8BA4\u5B9A\u4E3A\u662F\u8FD9\u573A\u706B\u707E\u7684\u5143\u51F6\u3002\u4F60\u5BF9\u8FD9\u4EF6\u4E8B\u60C5\u59CB\u7EC8\u65E0\u6CD5\u91CA\u6000\uFF0C\u8FD9\u4FBF\u662F\u4F60\u6765\u5230\u5C9B\u4E0A\u7684\u539F\u56E0\u3002"
  perspetive: "\u4F60\u8BA4\u4E3A<mark=#FF450065><color=#FFFFFFFF><b>\u201C\u7EB5\u706B\u8005\u201D</mark></color></b>\u4E4B\u6240\u4EE5\u88AB\u5B9A\u7F6A\uFF0C\u4E3B\u8981\u662F\u56E0\u4E3A<mark=#8B451365><color=#FFFFFFFF><b>\u5E97\u957F</mark></color></b>\u7684\u8BC1\u8BCD\u548C\u53D1\u73B0\uFF0C\u56E0\u6B64\u4F60\u5BF9\u4ED6\u5F88\u662F\u4E0D\u6EE1\u3002\n<u>\u5F53\u573A\u4E0A\u5B58\u5728<mark=#8B451365><color=#FFFFFFFF><b>\u5E97\u957F</mark></color></b>\u65F6\uFF0C\u82E5\u4F60\u6307\u8BA4<mark=#8B451365><color=#FFFFFFFF><b>\u5E97\u957F</mark></color></b>\u5E76\u6210\u529F\uFF0C\u4F60\u83B7\u5F97\u4E00\u5206\u3002\n</u><mark=#6B8E2365><color=#FFFFFFFF><b>\u62A4\u6797\u5458</mark></color></b>\u662F\u4F60\u7684\u631A\u53CB\uFF0C\u4F60\u66FE\u548C<mark=#6B8E2365><color=#FFFFFFFF><b>\u62A4\u6797\u5458</mark></color></b>\u7EA6\u5B9A\u8FC7\uFF0C\u5982\u679C\u6709\u4E00\u4EBA\u4E0D\u5E78\u9047\u96BE\uFF0C\u53E6\u5916\u4E00\u4E2A\u4EBA\u66FF\u5176\u7167\u987E\u5BB6\u5C5E\u3002\n<u>\u5F53\u573A\u4E0A\u7684\u6700\u7EC8\u751F\u8FD8\u8005\u662F<mark=#6B8E2365><color=#FFFFFFFF><b>\u62A4\u6797\u5458</mark></color></b>\u65F6\uFF0C\u4F60\u989D\u5916\u83B7\u5F97\u4E24\u5206\u3002</u>"
  otherRelation: "<mark=#FF450065><color=#FFFFFFFF><b>\u201C\u7EB5\u706B\u8005\u201D</mark></color></b>\u662F\u4F60\u7684\u5F1F\u5F1F\uFF0C\u5BF9\u4F60\u5341\u5206\u5C0A\u91CD\u3002\n<mark=#FFB6C165><color=#FFFFFFFF><b>\u82B1\u519C</mark></color></b>\u5BF9\u4F60\u5F88\u611F\u6FC0\u3002"
  skill: "\u5F53\u4F60\u6210\u4E3A\u4EE3\u7406\u4E3B\u6301\u65F6\uFF0C\u4F60\u53EF\u4EE5\u5C06\u4F60\u5403\u8FC7\u7684\u4E00\u5F20\u98DF\u7269\u6392\u653E\u7F6E\u5230\u5F03\u724C\u5806\uFF0C\u4F7F\u5176\u65E0\u6CD5\u88AB\u67E5\u770B\u3002"
