  name: "\u62A4\u6797\u5458"
  sprite: {fileID: 21300000, guid: 8f031106601294845a163a6f5d3e85af, type: 3}
  color: {r: 0.56699306, g: 0.754717, b: 0.19508718, a: 1}
  background: "\u706B\u707E\u6848\u4E2D\u4F60\u505A\u4E3A\u8BC1\u4EBA\u7AD9\u4E0A\u4E86\u6CD5\u5EAD\uFF0C\u5728<mark=#228B2265><color=#FFFFFFFF><b>\u730E\u4EBA</mark></color></b>\u7684\u62DC\u6258\u4E0B\u505A\u4E86\u4F2A\u8BC1\uFF0C\u9669\u4E9B\u88AB\u63ED\u7A7F\u3002\u4F60\u4E0D\u660E\u767D\u5199\u8FD9\u5C01\u9080\u8BF7\u51FD\u7684\u4EBA\u4E3A\u4EC0\u4E48\u77E5\u9053\u8FD9\u4EF6\u4E8B\uFF0C\u56E0\u6B64\u4F60\u6765\u5230\u4E86\u8FD9\u5EA7\u5C9B\u4E0A\u3002"
  perspetive: "\u672C\u5E94\u8BE5\u7AD9\u5728\u4F60\u8FD9\u8FB9\u7684<mark=#84891D75><color=#FFFFFFFF><b>\u5F8B\u5E08</mark></color></b>\u5BF9\u4F60\u7684\u8BC1\u8BCD\u53CD\u800C\u8FDB\u884C\u4E86\u8D28\u7591\uFF0C\u4F60\u6025\u4E2D\u751F\u667A\u624D\u8499\u6DF7\u8FC7\u5173\u3002\u4F60\u8BA8\u538C\u8FD9\u4E2A<mark=#84891D75><color=#FFFFFFFF><b>\u5F8B\u5E08</mark></color></b>\uFF0C\u4F46\u8FD9\u4E0D\u80FD\u660E\u9762\u4E0A\u8868\u73B0\u51FA\u6765\u3002\n<u>\u5F53\u573A\u4E0A\u5B58\u5728<mark=#84891D75><color=#FFFFFFFF><b>\u5F8B\u5E08</mark></color></b>\u65F6\uFF0C\u4F60\u4E0D\u80FD\u6307\u8BA4\u4ED6\uFF0C\u5426\u5219\u51CF\u5C11\u4E24\u5206\u3002\u5982\u679C<mark=#84891D75><color=#FFFFFFFF><b>\u5F8B\u5E08</mark></color></b>\u6B7B\u4EA1\uFF0C\u4F60\u83B7\u5F97\u4E00\u5206\u3002\n</u><mark=#FFB6C165><color=#FFFFFFFF><b>\u82B1\u519C</mark></color></b>\u5728\u8C03\u67E5\u706B\u707E\u6848\u65F6\u6CE8\u610F\u5230\u4E86\u4F60\u5728\u6CD5\u5EAD\u4E0A\u7684\u5F02\u5E38\u4E3E\u6B62\u3002\u5979\u8BA4\u4E3A\u4F60\u624D\u662F\u706B\u707E\u6848\u7684\u5143\u51F6\u3002\u4F60\u88AB\u8FEB\u5377\u5165\u5230\u4E86\u5979\u6240\u6563\u5E03\u7684\u6D41\u8A00\u5F53\u4E2D\u3002\n<u>\u5F53\u573A\u4E0A\u5B58\u5728<mark=#FFB6C165><color=#FFFFFFFF><b>\u82B1\u519C</mark></color></b>\u65F6\uFF0C\u5F53\u5176\u6B7B\u4EA1\u65F6\uFF0C\u4F60\u83B7\u5F97\u4E00\u5206\uFF0C\u82E5\u662F\u56E0\u4E3A\u88AB\u4F60\u6307\u8BA4\u4E86\u800C\u88AB\u6DD8\u6C70\uFF0C\u989D\u5916\u83B7\u5F97\u4E00\u5206\u3002</u>"
  otherRelation: "\u5728<mark=#228B2265><color=#FFFFFFFF><b>\u730E\u4EBA</mark></color></b>\u773C\u4E2D\uFF0C\u4F60\u662F\u4ED6\u7684\u631A\u53CB\u3002\n<mark=#00008075><color=#FFFFFFFF><b>\u8B66\u5BDF</mark></color></b>\u5F88\u8BA8\u538C\u4F60\u3002"
  skill: "\u5F53\u4F60\u6210\u4E3A\u4EE3\u7406\u4E3B\u6301\u65F6\uFF0C\u4F60\u4E0D\u9700\u8981\u4E22\u9AB0\u5B50\uFF0C\u800C\u662F\u53EF\u4EE5\u76F4\u63A5\u51B3\u5B9A\u662F\u5426\u6536\u96C6\u5230\u98DF\u7269\u3002"
  alphaInBG: 65
  colorTxt: 6B8E23
