  mainDescription: "\u83B7\u5F97\u5B88\u62A4\u5370\u8BB0\u6548\u679C\uFF1A<u><mark=#2B2B2B1E>\u4F60\u7684\u4E3B\u52A8\u56DE\u5408\u7ED3\u675F\u65F6</u></mark>\uFF0C\u5370\u8BB0\u91CD\u7F6E\u4E3A\u4E00\u5C42\u3002\u4E00\u5C42\u5B88\u62A4\u5370\u8BB0\u53EF\u4EE5\u5728\u88AB\u52A8\u65F6\u89C6\u4E3A\u4E00\u5F20\u4E07\u80FD\u5C5E\u6027\u6CD5\u672F\u4F7F\u7528\uFF08\u4E14\u4E0D\u6D88\u8017\u6CD5\u529B\u503C\uFF09\u3002"
  additionalDescription: "\u82E5\u4F7F\u7528\u6761\u4EF6\u4FEE\u9970\u4E3A\u4E3B\u52A8\u56DE\u5408\u5F00\u59CB\u65F6\uFF0C\u5219\u5B88\u62A4\u5370\u8BB0\u53EF\u4EE5\u5728\u4E3B\u52A8\u65F6\u4F7F\u7528\uFF0C\u89C6\u4E3A\u4E00\u5F20\u4E07\u80FD\u5C5E\u6027\u6CD5\u672F\u3002"
